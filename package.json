{
  "name": "campus-market",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "前后端综合项目：校园二手交易平台（Vue 3 + Element Plus + Vant + Vue Router + Axios + Pinia + json-server）",
  "scripts": {
    "dev": "vite",
    "server": "json-server --watch server/db.json --port 3001",
    "start": "concurrently -n API,WEB -c yellow,green \"npm:server\" \"npm:dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist --dotfiles"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.21.0",
    "element-plus": "^2.14.7",
    "json-server": "^0.17.4",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vant": "^4.10.2",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^9.1.2",
    "gh-pages": "^6.3.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5"
  }
}
